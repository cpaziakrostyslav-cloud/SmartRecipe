<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SmartRecipe.ViewModels"
             xmlns:models="using:SmartRecipe.Models"
             x:DataType="vm:RecipesViewModel"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SmartRecipe.Views.RecipesView">
    <Grid RowDefinitions="Auto, Auto, *">
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,20">
            <TextBlock Grid.Column="0" 
                       Text="{DynamicResource RecipesMenu}" 
                       Classes="PageTitle" 
                       Margin="0"/>
            <Button Grid.Column="1" 
                    Content="{DynamicResource AddRecipe}" 
                    Command="{Binding ToggleAddFormCommand}"
                    Background="#34495E"
                    Foreground="White"
                    Cursor="Hand"
                    Padding="15,8"
                    CornerRadius="5"/>
        </Grid>

        <Border Grid.Row="1" 
                Classes="Card" 
                IsVisible="{Binding IsAddFormVisible}" 
                Background="#ECF0F1"
                Margin="0,0,0,20">
            <StackPanel Spacing="10">
                <TextBlock Text="{DynamicResource NewRecipe}" FontWeight="Bold" FontSize="16" Foreground="#2C3E50"/>
                
                <TextBox Text="{Binding NewRecipeName}" Watermark="{DynamicResource ExampleName}"/>
                <TextBox Text="{Binding NewRecipeDescription}" Watermark="{DynamicResource ExampleDescription}" Height="60" TextWrapping="Wrap"/>
                <TextBox Text="{Binding NewRecipeIngredients}" Watermark="{DynamicResource ExampleIngredients}"/>
                
                <Button Content="{DynamicResource SaveToCatalog}" 
                        Command="{Binding AddNewRecipeCommand}"
                        Background="#27AE60"
                        Foreground="White"
                        HorizontalAlignment="Right"
                        Cursor="Hand"
                        Padding="15,8"
                        CornerRadius="5"/>
            </StackPanel>
        </Border>

        <ListBox Grid.Row="2" 
                 ItemsSource="{Binding Recipes}" 
                 Background="Transparent"
                 BorderThickness="0">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="models:Recipe">
                    <Border Classes="Card">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Name}" 
                                           FontSize="18" 
                                           FontWeight="Bold" 
                                           Foreground="#2C3E50"/>
                                
                                <TextBlock Text="{Binding MatchStatus}" 
                                           Foreground="{Binding StatusColor}" 
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           Margin="0,5,0,5"/>
                                
                                <TextBlock Text="{Binding Description}" 
                                           FontSize="14" 
                                           Foreground="Gray" 
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <Button Grid.Column="1" 
                                    Content="{DynamicResource Delete}" 
                                    Command="{Binding $parent[UserControl].DataContext.DeleteRecipeCommand}"
                                    CommandParameter="{Binding}"
                                    x:CompileBindings="False"
                                    Background="#E74C3C" 
                                    Foreground="White"
                                    VerticalAlignment="Top"
                                    Cursor="Hand"
                                    Padding="10,5"
                                    CornerRadius="5"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
