<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SmartRecipe.ViewModels"
             xmlns:models="using:SmartRecipe.Models"
             x:DataType="vm:FridgeViewModel"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SmartRecipe.Views.FridgeView">
    <Grid RowDefinitions="Auto, *, Auto">
        
        <TextBlock Grid.Row="0" 
                   Text="{DynamicResource Ingredients}" 
                   Classes="PageTitle"/>

        <ListBox Grid.Row="1" 
                 ItemsSource="{Binding Ingredients}" 
                 Background="Transparent"
                 BorderThickness="0">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="models:Ingredient">
                    <Border Classes="Card">
                        <CheckBox IsChecked="{Binding IsAvailable}" 
                                  Content="{Binding Name}" 
                                  Classes="CardCheckbox"/>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Margin="0,20,0,0" 
                    Spacing="15">
            
            <TextBlock Text="{DynamicResource SuccessSave}" 
                       IsVisible="{Binding IsSavedMessageVisible}"
                       VerticalAlignment="Center"
                       Foreground="#27AE60"
                       FontWeight="SemiBold"
                       FontSize="16"/>

            <Button Content="{DynamicResource SaveMyFridge}" 
                    Command="{Binding SaveCommand}"
                    Padding="20,10"
                    Background="#3498DB"
                    Foreground="White"
                    CornerRadius="8"
                    FontWeight="Bold"
                    FontSize="16"
                    Cursor="Hand"/>
        </StackPanel>
    </Grid>
</UserControl>
