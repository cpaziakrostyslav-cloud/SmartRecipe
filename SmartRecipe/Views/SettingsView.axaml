<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SmartRecipe.ViewModels"
             x:DataType="vm:SettingsViewModel"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SmartRecipe.Views.SettingsView">
    <Grid RowDefinitions="Auto, *">
        <TextBlock Grid.Row="0" Text="{DynamicResource SettingsTitle}" Classes="PageTitle"/>

        <StackPanel Grid.Row="1" Spacing="20">
            <Border Classes="Card">
                <StackPanel Spacing="10">
                    <TextBlock Text="{DynamicResource ThemeTitle}" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}"/>
                    <TextBlock Text="{DynamicResource ThemeDesc}" FontSize="14" Foreground="Gray"/>
                    
                    <ToggleSwitch IsChecked="{Binding IsDarkMode}" 
                                  OnContent="{DynamicResource DarkThemeOn}" 
                                  OffContent="{DynamicResource DarkThemeOff}"
                                  Foreground="{DynamicResource PrimaryText}"/>
                </StackPanel>
            </Border>

            <Border Classes="Card">
                <StackPanel Spacing="10">
                    <TextBlock Text="{DynamicResource LangTitle}" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}"/>
                    <TextBlock Text="{DynamicResource LangDesc}" FontSize="14" Foreground="Gray"/>
                    
                    <ComboBox ItemsSource="{Binding Languages}" 
                              SelectedItem="{Binding SelectedLanguage}" 
                              Width="200" 
                              Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
