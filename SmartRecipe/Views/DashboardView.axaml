<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SmartRecipe.ViewModels"
             x:DataType="vm:DashboardViewModel"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SmartRecipe.Views.DashboardView">
    <ScrollViewer>
        <StackPanel Spacing="20">
            
            <Border CornerRadius="10" Padding="25" Background="#3498DB">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Welcome}" 
                               FontSize="28" 
                               FontWeight="Bold" 
                               Foreground="White" 
                               Margin="0,0,0,10"/>
                    <TextBlock Text="{DynamicResource WelcomeInstrument}" 
                               FontSize="16" 
                               Foreground="#ECF0F1"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*, *, *">
                <Border Grid.Column="0" Classes="Card" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource CountRecipes}" Foreground="Gray" FontSize="14"/>
                        <TextBlock Text="{Binding TotalRecipes}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}"/>
                    </StackPanel>
                </Border>
                
                <Border Grid.Column="1" Classes="Card" Margin="10,0,10,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource CountProduct}" Foreground="Gray" FontSize="14"/>
                        <TextBlock Text="{Binding TotalIngredients}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}"/>
                    </StackPanel>
                </Border>
                
                <Border Grid.Column="2" Classes="Card" Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Available}" Foreground="Gray" FontSize="14"/>
                        <TextBlock Text="{Binding AvailableIngredients}" FontSize="24" FontWeight="Bold" Foreground="#27AE60"/>
                    </StackPanel>
                </Border>
            </Grid>
            <TextBlock Text="{DynamicResource Recommend}" Classes="PageTitle" Margin="0,10,0,0"/>
            <Border Classes="Card">
                <Grid ColumnDefinitions="Auto, *">
                    <Border Grid.Column="0" Width="100" Height="100" CornerRadius="8" Background="#BDC3C7" Margin="0,0,15,0">
                        <TextBlock Text="{DynamicResource Photo}" 
                                   Foreground="White" 
                                   FontWeight="Bold" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding RecipeOfTheDay.Name}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}"/>
                        <TextBlock Text="{Binding RecipeOfTheDay.Description}" FontSize="14" Foreground="Gray" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
